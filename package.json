{
  "name": "induccion-rrhh-lavin",
  "version": "1.0.0",
  "description": "Plataforma de inducción on-premise — RR.HH. Lavín",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -n api,vue -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development nodemon src/server.js",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm ci --prefix client && npm run build --prefix client",
    "seed": "node scripts/seed.js",
    "migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.18.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
